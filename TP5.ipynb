   "source": [
    "### 2.6 Análisis bivariado — categóricas vs `Churn`\n",
    "\n",
    "Calculamos la **tasa de churn** por categoría para identificar segmentos de alto riesgo."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "ccc32ddf",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1600x900 with 6 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "def churn_rate_by_category(df, col, ax):\n",
    "    tmp = (\n",
    "        df.groupby(col)['Churn']\n",
    "        .apply(lambda s: (s == 'Yes').mean() * 100)\n",
    "        .sort_values(ascending=False)\n",
    "    )\n",
    "    sns.barplot(x=tmp.index.astype(str), y=tmp.values, ax=ax, palette='Reds_r')\n",
    "    ax.set_ylabel('Tasa de Churn (%)')\n",
    "    ax.set_title(f'Tasa de Churn por {col}')\n",
    "    ax.tick_params(axis='x', rotation=30)\n",
    "    ax.axhline(df['Churn'].eq('Yes').mean() * 100, color='gray', ls='--', lw=1, label='Promedio global')\n",
    "    ax.legend(fontsize=8)\n",
    "\n",
    "\n",
    "# Agrupamos tenure en bins para visualizar\n",
    "train_eda = train_df.copy()\n",
    "train_eda['tenure_group'] = pd.cut(\n",
    "    train_eda['tenure'],\n",
    "    bins=[-1, 12, 24, 48, 72],\n",
    "    labels=['0-12', '13-24', '25-48', '49-72'],\n",
    ")\n",
    "\n",
    "focus_cats = [\n",
    "    'Contract', 'InternetService', 'PaymentMethod',\n",
    "    'TechSupport', 'OnlineSecurity', 'tenure_group',\n",
    "]\n",
    "\n",
    "fig, axes = plt.subplots(2, 3, figsize=(16, 9))\n",
    "axes = axes.flatten()\n",
    "for ax, col in zip(axes, focus_cats):\n",
    "    churn_rate_by_category(train_eda, col, ax)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
