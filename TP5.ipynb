   "source": [
    "pipe_logreg = Pipeline(steps=[\n",
    "    ('preprocessor', preprocessor),\n",
    "    ('model', LogisticRegression(\n",
    "        max_iter=1000,\n",
    "        class_weight='balanced',\n",
    "        random_state=RANDOM_STATE,\n",
    "    )),\n",
    "])\n",
    "\n",
    "param_grid_lr = {\n",
    "    'model__C': [0.01, 0.1, 1, 10, 100],\n",
    "    'model__solver': ['lbfgs'],\n",
    "}\n",
    "\n",
    "gs_lr = GridSearchCV(\n",
    "    pipe_logreg,\n",
    "    param_grid_lr,\n",
    "    scoring='roc_auc',\n",
    "    cv=cv,\n",
    "    n_jobs=N_JOBS,\n",
    "    refit=True,\n",
    ")\n",
    "gs_lr.fit(X_train, y_train)\n",
    "\n",
    "print(\"Mejores hiperparámetros (LogReg):\", gs_lr.best_params_)\n",
    "print(f\"Mejor ROC AUC (CV): {gs_lr.best_score_:.4f}\")\n",
    "\n",
    "best_logreg = gs_lr.best_estimator_\n",
    "metrics_lr, y_pred_lr, y_proba_lr = evaluate_on_validation(\n",
    "    best_logreg, 'Regresión Logística', X_val, y_val\n",
    ")\n",
    "print(\"\\nMétricas en validación:\")\n",
    "display(pd.Series(metrics_lr))\n",
    "print(\"\\nClassification Report:\\n\")\n",
    "print(classification_report(y_val, y_pred_lr, target_names=['No Churn', 'Churn']))\n",
    "plot_confusion(y_val, y_pred_lr, 'Matriz de Confusión — Regresión Logística')"
   ]
